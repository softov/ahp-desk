node_modules
dist
*.tsbuildinfo

# Rust build output, and the schemas Tauri generates on each build.
/src-tauri/target
/src-tauri/gen

# The UI bundle scripts/stage-ui.mjs copies in before a release build.
/src-tauri/resources/ui

# The Node runtime scripts/stage-node.mjs fetches, and its download cache.
/src-tauri/resources/node
/.cache

# Tauri updater signing keys. The public key lives in tauri.conf.json.
*.key
*.key.pub
.tauri/

# Code signing certificates and their passwords.
*.pfx
*.p12
*.pem
*.cer
*.crt
*.keystore
*.jks

# SSH keys a remote install might be tested with.
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts

# Local environment and secrets.
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/
credentials*.json
tokens*.json

# Local experiments, kept out of git for now.
/.scratch
