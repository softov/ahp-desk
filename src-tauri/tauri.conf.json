{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ahp-desk",
  "version": "0.1.0",
  "identifier": "dev.softov.ahpdesk",
  "build": {
    "beforeDevCommand": "pnpm stage:all && pnpm --filter @ahp-desk/shell dev",
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": "pnpm stage:all && pnpm --filter @ahp-desk/shell build",
    "frontendDist": "../packages/shell/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "resources": {
      "resources/ui/": "ui/",
      "resources/node/": "node/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4N0MyN0IzMTNFQTNBM0EKUldRNk91b1RzeWQ4S0lMdGV6RGZ2NTVUVXlDdXEwTmJnMng2Y2w0c1QvK3J0ZzRmNENMVlByeFgK",
      "endpoints": ["https://github.com/softov/ahp-desk/releases/latest/download/latest.json"]
    }
  }
}
