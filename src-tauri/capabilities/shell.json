{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "The host list window: it keeps the hosts and opens them.",
  "windows": ["shell"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-hosts",
    "allow-save-host",
    "allow-remove-host",
    "allow-host-token",
    "allow-open-app-window",
    "allow-publish-host-statuses",
    "allow-host-statuses",
    "allow-find-local-ahpd",
    "allow-install-local-ahpd",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://ahpio.com" }]
    }
  ]
}
