{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "The host list window: it keeps the hosts and opens them.",
  "windows": ["shell"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-hosts",
    "allow-save-host",
    "allow-remove-host",
    "allow-host-token",
    "allow-open-app-window",
    "allow-publish-host-statuses",
    "allow-host-statuses",
    "allow-find-local-ahpd",
    "allow-install-local-ahpd",
    "allow-add-local-backends",
    "allow-serve-local-folder",
    "allow-local-home-folder",
    "allow-local-ahpd-status",
    "allow-start-local-ahpd",
    "allow-stop-local-ahpd",
    "allow-set-tray-words",
    "allow-settings",
    "allow-save-settings",
    "allow-start-with-os",
    "allow-set-start-with-os",
    "allow-ssh-keyring-works",
    "allow-confirm-ssh-key",
    "allow-forget-ssh-key",
    "allow-probe-ssh-server",
    "allow-install-ssh-ahpd",
    "allow-cancel-ssh-install",
    "allow-uninstall-ssh-ahpd",
    "allow-updates",
    "allow-update-ssh-ahpd",
    "allow-desk-update",
    "allow-install-desk-update",
    "allow-check-desk-update",
    "allow-about",
    "allow-ssh-tunnel-states",
    "allow-local-starting",
    "allow-open-ssh-tunnel",
    "allow-ssh-sign-in",
    "allow-pick-ssh-local-port",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://ahpio.com" }, { "url": "https://github.com/softov/ahp-desk/releases" }]
    }
  ]
}
