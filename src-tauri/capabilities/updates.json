  "identifier": "updates",
  "description": "The Updates window: the desk's update check, the ready update and its Restart.",
  "windows": ["updates"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
